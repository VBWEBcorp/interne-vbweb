    "start": "tsx server/index.ts",
    "build": "tsc -b && vite build && tsx scripts/generate-sitemap.ts",
    "sitemap": "tsx scripts/generate-sitemap.ts",
    "lint": "eslint .",
    "preview": "vite preview"
  },
